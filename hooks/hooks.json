{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent_stop.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(command -v python || command -v python3); \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
