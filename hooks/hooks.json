{
  "modules": [
    "./mod/register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\"; [ -f \"$s\" ] || exit 0; p=$(command -v python || command -v python3); \"$p\" \"$s\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
